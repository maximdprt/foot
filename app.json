{
  "expo": {
    "name": "Pelouse",
    "slug": "pelouse",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pelouse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FFFFFF",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pelouse.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pelouse utilise ta position pour renseigner ta ville et te proposer des terrains proches.",
        "NSPhotoLibraryUsageDescription": "Pelouse accède à tes photos pour choisir ta photo de profil.",
        "NSCameraUsageDescription": "Pelouse utilise l'appareil photo pour prendre ta photo de profil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.pelouse.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pelouse utilise ta position pour renseigner ta ville et te proposer des terrains proches."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pelouse accède à tes photos pour choisir ta photo de profil.",
          "cameraPermission": "Pelouse utilise l'appareil photo pour prendre ta photo de profil."
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {}
    }
  }
}
